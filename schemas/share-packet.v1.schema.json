    "founder_id",
    "asset_id",
    "asset_type",
    "title",
    "summary",
    "allowed_channels",
    "source_refs",
    "exported_at"
  ],
  "properties": {
    "sync_id": { "type": "string" },
    "founder_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "asset_type": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "allowed_channels": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "exported_at": { "type": "string" }
  },
  "additionalProperties": false
